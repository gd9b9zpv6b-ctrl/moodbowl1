# Expo client · public values only
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Temporary FastAPI compatibility layer · remove after Phase 5
EXPO_PUBLIC_BACKEND_URL=http://localhost:8000

# Backend-only migration settings · never expose these through EXPO_PUBLIC_*
SUPABASE_URL=https://your-project.supabase.co
# Optional for projects still using the legacy HS256 JWT secret.
SUPABASE_JWT_SECRET=
